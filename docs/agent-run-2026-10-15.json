        "expected": "'postgresql://u:p@h:5432/d'",
        "assertion": "toBe exact string; second case: with no override, DATABASE_URL is returned (also normalized)",
        "mockBoundary": "vi.stubEnv / unstubAllEnvs only; no module mocks",
        "confidence": "characterization"
